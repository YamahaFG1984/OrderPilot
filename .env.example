# 复制为 .env 后按需修改
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://orderpilot:orderpilot@localhost:5436/orderpilot
CELERY_BROKER_URL=redis://localhost:6381/0

# 客户扩展（dev 环境默认 extensions.demo_jp）
ORDERPILOT_EXTENSION=extensions.demo_jp
# ERP 适配器（默认使用模拟金蝶）
ORDERPILOT_ERP_ADAPTER=orderpilot.platform.integrations.adapters.mock_kingdee.MockKingdeeAdapter
# 邮件通知里链接的站点地址
ORDERPILOT_SITE_URL=http://localhost:8010
# 登录页列出演示账号（仅本地演示使用，公网访问务必为 false）
ORDERPILOT_SHOW_DEMO_ACCOUNTS=false
# 配好域名和 HTTPS 后改为 true（安全 Cookie、HTTPS 跳转、HSTS）
DJANGO_HTTPS=false
# 登录连续失败多少次后锁定，锁定多少小时
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# 预警扫描间隔（秒）
ALERT_SCAN_SECONDS=60
